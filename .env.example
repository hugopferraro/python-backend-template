# Environment Configuration
# Copy this file to .env and adjust values for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment: dev | staging | prod
APP_ENV=dev

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG
LOG_SQL_QUERIES=false

# =============================================================================
# DATABASE
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Generate a secure key for production: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256

# =============================================================================
# API SECURITY
# =============================================================================

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=[]

# =============================================================================
# GRAFANA SMTP (for alerts)
# =============================================================================

# Example for Gmail: smtp.gmail.com:587 (use an App Password, not your account password)
# Example for AWS SES: email-smtp.us-east-1.amazonaws.com:587
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=your-email@example.com
GF_SMTP_PASSWORD=your-smtp-password
GF_SMTP_FROM_ADDRESS=alerts@example.com
GF_SMTP_FROM_NAME=Grafana
